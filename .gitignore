# Go build output
/backend/shelfmark
/bin/
/dist/
*.exe
*.test
*.out
coverage.*

# Go workspace (local only)
go.work
go.work.sum

# Environment and secrets
.env
.env.*
!.env.example

# Frontend (details in web/.gitignore)
node_modules/

# Bootstrapper temp directory
/.bootstrap-scaffold/

# Local Claude Code settings and course skill downloads (not published).
# Project hooks are committed: settings.json + hooks/ (settings.local.json stays local).
# Exception: skills/10x-impl-review-ci/ is committed, because the Impl Review
# workflow (.github/workflows/impl-review.yml) stages it from the PR's base branch.
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/skills/
.claude/skills/*
!.claude/skills/10x-impl-review-ci/

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store

# Playwright
**/playwright/.auth/
test-results/
playwright-report/
blob-report/
**/playwright/.cache/
.playwright-cli/
