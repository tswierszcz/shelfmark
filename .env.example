# Shelfmark server configuration. Copy to .env and fill in; never commit real values.

# --- Required ---------------------------------------------------------------

# Postgres connection string. Migrations run automatically on startup.
DATABASE_URL=postgres://shelfmark:shelfmark@localhost:5432/shelfmark?sslmode=disable

# HMAC key for signing session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Seed accounts: used only to create the first three users when the `users`
# table is empty (first start). Afterwards, manage users in the app as Admin.
# Hashes are bcrypt, e.g.: htpasswd -nbBC 10 x 'password' | cut -d: -f2
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
ARCHITECT_EMAIL=
ARCHITECT_PASSWORD_HASH=
VIEWER_EMAIL=
VIEWER_PASSWORD_HASH=

# OpenRouter API key for the LLM repo-finder fallback and categorization.
# The server refuses to start without it.
OPENROUTER_API_KEY=

# --- Optional ---------------------------------------------------------------

# OpenRouter model id (default: glm-5.3).
OPENROUTER_MODEL=

# GitHub token for topic lookups; unauthenticated requests hit low rate limits.
GITHUB_TOKEN=

# HTTP port (default: 8080).
PORT=

# Directory with the built SPA (default: ../web/build/client; /app/public in the Docker image).
STATIC_DIR=
